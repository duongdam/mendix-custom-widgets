<?xml version="1.0" encoding="utf-8"?>
<widget id="com.iris.widgets.IRISSteps" pluginWidget="true" needsEntityContext="true" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>IRIS Steps</name>
    <description>Ant Design Steps (wizard / process indicator), with the current step stored in an Integer attribute.</description>
    <icon/>
    <properties>
        <propertyGroup caption="Data">
            <property key="prpCurrent" type="attribute" required="true">
                <caption>Current step</caption>
                <description>0-based index of the current step (0 = first step).</description>
                <attributeTypes>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                </attributeTypes>
            </property>
            <property key="prpItemsSource" type="enumeration" defaultValue="static">
                <caption>Steps source</caption>
                <description>Static: define the steps below. Data source: one step per object of a list.</description>
                <enumerationValues>
                    <enumerationValue key="static">Static</enumerationValue>
                    <enumerationValue key="datasource">Data source</enumerationValue>
                </enumerationValues>
            </property>
            <property key="prpStaticItems" type="object" isList="true" required="false">
                <caption>Steps</caption>
                <description>Only used when Steps source is Static.</description>
                <properties>
                    <propertyGroup caption="Step">
                        <property key="prpTitle" type="textTemplate" required="true">
                            <caption>Title</caption>
                            <description>Step title.</description>
                        </property>
                        <property key="prpDescription" type="textTemplate" required="false">
                            <caption>Description</caption>
                            <description>Optional text under the title.</description>
                        </property>
                    </propertyGroup>
                </properties>
            </property>
            <property key="prpItemsDatasource" type="datasource" isList="true" required="false">
                <caption>Steps</caption>
                <description>Only used when Steps source is Data source. Sort it in step order.</description>
            </property>
            <property key="prpItemTitle" type="textTemplate" dataSource="prpItemsDatasource" required="false">
                <caption>Step title</caption>
                <description>Title of each step from the data source.</description>
            </property>
            <property key="prpItemDescription" type="textTemplate" dataSource="prpItemsDatasource" required="false">
                <caption>Step description</caption>
                <description>Optional description of each step from the data source.</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Behavior">
            <property key="prpClickable" type="boolean" defaultValue="false">
                <caption>Clickable</caption>
                <description>Let users jump to a step by clicking it (writes Current step).</description>
            </property>
            <property key="prpErrorWhen" type="expression" required="false">
                <caption>Error when</caption>
                <description>When true, the current step is shown as Error.</description>
                <returnType type="Boolean"/>
            </property>
        </propertyGroup>
        <propertyGroup caption="Appearance">
            <property key="prpStepsType" type="enumeration" defaultValue="default">
                <caption>Type</caption>
                <description>Visual style of the steps.</description>
                <enumerationValues>
                    <enumerationValue key="default">Default</enumerationValue>
                    <enumerationValue key="navigation">Navigation</enumerationValue>
                    <enumerationValue key="dot">Dot</enumerationValue>
                    <enumerationValue key="inline">Inline</enumerationValue>
                    <enumerationValue key="panel">Panel</enumerationValue>
                </enumerationValues>
            </property>
            <property key="prpOrientation" type="enumeration" defaultValue="horizontal">
                <caption>Orientation</caption>
                <description>Lay the steps out in a row or a column.</description>
                <enumerationValues>
                    <enumerationValue key="horizontal">Horizontal</enumerationValue>
                    <enumerationValue key="vertical">Vertical</enumerationValue>
                </enumerationValues>
            </property>
            <property key="prpSize" type="enumeration" defaultValue="medium">
                <caption>Size</caption>
                <description>Size of the step icons and text.</description>
                <enumerationValues>
                    <enumerationValue key="medium">Medium</enumerationValue>
                    <enumerationValue key="small">Small</enumerationValue>
                </enumerationValues>
            </property>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="prpOnChange" type="action" required="false">
                <caption>On change</caption>
                <description>Runs after Current step changes by a click.</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
